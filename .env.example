# Скопируйте в .env. Все значения необязательны: ниже указаны значения по умолчанию.
# В Docker пути к БД и конфигу задаёт docker-compose.yml.

LOG_LEVEL=INFO

# Токены и ключи здесь не хранятся: для них есть tm secrets.

# Смещение вашего времени от UTC в часах, для показа времени сообщений.
BOT_UTC_OFFSET_HOURS=0

# Через сколько минут недоступности модели прислать предупреждение.
OLLAMA_ALERT_MINUTES=30

# Глубина истории при первом чтении чата, в днях.
HISTORY_DEPTH_DAYS=30

# Адрес Ollama. В Docker по умолчанию http://host.docker.internal:11434.
# OLLAMA_URL=http://127.0.0.1:11434

# Модель и промпт для входящих сообщений из config/prompts/.
ANALYZER_MODEL=gemma4:12b
ANALYZER_PROMPT=task_v4.md
